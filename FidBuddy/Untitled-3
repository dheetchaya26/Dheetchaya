import os
from google import genai

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")

client = genai.Client(api_key=GEMINI_API_KEY)


def generate_workout_plan(name, age, weight, goal, intensity):
    prompt = f"""
    Create a personalized 7-day workout plan for the following user:

    Name: {name}
    Age: {age}
    Weight: {weight} kg
    Fitness Goal: {goal}
    Workout Intensity: {intensity}

    Include:
    - Day-wise workout plan
    - Exercises
    - Sets and repetitions
    - Rest days
    - Basic safety tips

    Keep the plan simple and easy to follow.
    """

    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt
    )

    return response.text


def update_workout_plan(old_plan, feedback):
    prompt = f"""
    Here is the current workout plan:

    {old_plan}

    User feedback:
    {feedback}

    Generate an updated workout plan based on the user's feedback.
    Keep it simple, safe, and easy to follow.
    """

    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt
    )

    return response.text


def generate_fitness_tip(goal):
    prompt = f"""
    Give one simple nutrition or recovery tip for a person
    whose fitness goal is: {goal}
    """

    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt
    )

    return response.text